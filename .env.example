# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Dashboard → Project Settings → API). La chiave "publishable"/"anon" è pubblica
# per design: la sicurezza dei dati è garantita dalle policy RLS del database.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Squeak AI: chiave dell'API di Anthropic (console.anthropic.com → API Keys).
# È segreta: resta solo sul server, mai con il prefisso NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Solo se la chiave non è legata a un workspace: ID del workspace da usare (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
# Solo per sviluppo locale: apre Squeak AI senza account Pro. Mai in produzione.
SQUEAK_AI_DEV_UNLOCK=false
