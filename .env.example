# Copia questo file in .env.local e inserisci i valori veri. .env.local NON va mai su git.
#
# Regola d'oro: solo le variabili NEXT_PUBLIC_ finiscono nel browser. Tutto il resto resta sul server.

# --- Supabase (Dashboard → Project Settings → API) ---
# Pubbliche per design: la sicurezza dei dati è garantita dalle policy RLS del database.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chiave segreta (secret / service_role): bypassa l'RLS. Solo server, mai con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App installate (desktop/Android) ---
# Indirizzo del sito a cui le app chiedono le API (es. https://squeakedit.app). Vuoto = stesso sito.
NEXT_PUBLIC_API_BASE=
# Dove si scaricano gli installer (pagina Download).
NEXT_PUBLIC_DOWNLOAD_BASE=

# --- Pannello admin ---
# Solo l'hash della password, mai la password. Formato: scrypt:<salt hex>:<hash hex>
ADMIN_PASSWORD_HASH=
# Stringa casuale lunga (almeno 32 caratteri) per firmare la sessione admin.
ADMIN_SESSION_SECRET=
# Hash lento (pbkdf2) usato solo dall'anteprima a file unico. Le app distribuite si compilano con SQUEAK_NO_ADMIN=1.
ADMIN_PREVIEW_HASH=

# --- Squeak AI (console.anthropic.com → API Keys) ---
# Segreta: resta solo sul server, mai con il prefisso NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Solo se la chiave non è legata a un workspace (wrkspc_…).
ANTHROPIC_WORKSPACE_ID=
# Solo per sviluppo locale: apre Squeak AI senza account Pro. Mai in produzione.
SQUEAK_AI_DEV_UNLOCK=false
