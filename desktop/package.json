{
  "name": "squeakedit-desktop",
  "productName": "SqueakEdit",
  "version": "1.0.0",
  "description": "SqueakEdit: impara il montaggio video come su Duolingo",
  "author": "SqueakEdit",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "app": "node prepare.mjs app/index.html",
    "start": "npm run app && electron .",
    "dist:win": "npm run app && electron-builder --win --publish never",
    "dist:mac": "npm run app && electron-builder --mac --publish never",
    "dist:linux": "npm run app && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.squeakedit.app",
    "productName": "SqueakEdit",
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SqueakEdit-Windows-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": "-"
    },
    "dmg": {
      "artifactName": "SqueakEdit-Mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "SqueakEdit-Linux.${ext}"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
